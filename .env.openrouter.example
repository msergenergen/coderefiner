# Copy to .env.openrouter (git-ignored) and paste your keys.
# Only these lines are read; experiment settings live in config/openrouter.env.
OPENROUTER_API_KEY=

# Optional: Langfuse tracing (https://cloud.langfuse.com → project → API keys).
# Leave empty to run without tracing. Self-hosted: set LANGFUSE_BASE_URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
